# Copy to .env and fill in. NEVER commit .env.
# `npm run demo` and `npm run verify` need none of this — only real captures do.

# Bright Data API key (https://brightdata.com/cp/setting/users). If the key has an IP allowlist,
# this machine's egress IP must be on it — a missing entry fails as "401 Invalid credentials".
BRIGHTDATA_API_KEY=

# Collector ids, one per outlet, produced by `brightdata scraper create`.
# See collectors/README.md for how each was built and what it returns.
FPTM_COLLECTORS=npr:c_xxxxxxxx,bbc:c_yyyyyyyy
