{
  "name": "front-page-time-machine",
  "version": "0.1.0",
  "description": "Front Page Time Machine — a memory of what the public web cared about. Hourly public news homepage snapshots collected via Bright Data Scraper Studio.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "//env": "--env-file-if-exists so a fresh clone with no .env still runs `demo`, which needs no secrets.",
    "demo": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts demo",
    "capture": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts capture",
    "watch": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts watch",
    "diff": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts diff",
    "story": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts story",
    "timeline": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts timeline",
    "heal": "node --env-file-if-exists=.env --import tsx src/cli/fptm.ts heal",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "coverage": "c8 mocha",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "//verify": "Every gate, in cheapest-first order. Green on a fresh clone with no collectors and no captures, so a red `verify` always means a real regression.",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "chai": "^5.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.2"
  }
}
